<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Central package versions for projects that opt into central management -->
  <ItemGroup>
    <!-- Pin the WebView2 runtime package used by the WPF app -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
</Project>
